# API Information


main: {
  kit: {
    info: {
      contact: {
        name: "TMDB API documentation"
        url: "https://developer.themoviedb.org/"
      }
      description: "Focused OpenAPI subset for TMDB movie search and movie details."
      security: {
        in: "header"
        name: "Authorization"
        prefix: "Bearer"
        scheme: "sec0"
        type: "http"
      }
      servers: [
        {
          url: "https://api.themoviedb.org"
        }
      ]
      summary: "Focused OpenAPI subset for TMDB movie search and movie details."
      title: "TMDB API v3"
      version: "3"
      website: "https://themoviedb.org"
    }
  }
}

